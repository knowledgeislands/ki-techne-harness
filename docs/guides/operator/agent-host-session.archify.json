  "cards": [
    {
      "dot": "cyan",
      "title": "Before this",
      "items": [
        "With --aws the helper first assumes the agent-host profile",
        "and starts the host if it is stopped",
        "Kris has signed Claude Code in once on the host"
      ]
    },
    {
      "dot": "rose",
      "title": "Rules in the session",
      "items": [
        "Only Kris opens sessions: no schedules, webhooks or messages",
        "No push without Kris's request, no force-push, no --no-verify",
        "The token reaches git on demand and is never written to disk"
      ]
    }
  ]
