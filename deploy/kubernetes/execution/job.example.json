{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "techne-local-42",
    "namespace": "techne-execution",
    "labels": {
      "app.kubernetes.io/name": "techne-execution",
      "techne.knowledgeislands.dev/execution": "local-42"
    },
    "annotations": {
      "techne.knowledgeislands.dev/execution-id": "telegram:42:local"
    }
  },
  "spec": {
    "activeDeadlineSeconds": 300,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "techne-execution",
          "techne.knowledgeislands.dev/execution": "local-42"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "serviceAccountName": "techne-execution",
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "workload",
            "image": "docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "/bin/sh",
              "-c",
              "printf '%s\\n' '{\"execution_id\":\"telegram:42:local\",\"outcome\":\"completed\"}'"
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": ["ALL"]
              },
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true,
              "runAsUser": 65534
            }
          }
        ]
      }
    }
  }
}
