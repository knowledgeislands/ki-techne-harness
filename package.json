{
  "name": "@knowledgeislands/ki-techne-harness",
  "description": "Runnable personal-controller and execution-fabric harness for the Knowledge Islands ecosystem.",
  "version": "0.1.0",
  "author": "kris@kris.me.uk",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "1.4.3",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-techne-harness#readme",
  "keywords": [
    "bun",
    "controller",
    "execution-fabric",
    "k3s",
    "knowledge-islands",
    "kubernetes",
    "typescript"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.2",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-techne-harness.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist",
    "ki:deps:update": "bun update --latest",
    "prepare": "git config core.hooksPath .githooks",
    "self:aws:validate": "bash operations/aws/validate-cloudformation.sh",
    "self:controller:encrypt-secrets": "bash operations/aws/controller/enable-secrets-encryption.sh",
    "self:deps:layout": "bash tooling/checks/root-dependencies.sh",
    "test": "bun run self:deps:layout && turbo run typecheck test"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
